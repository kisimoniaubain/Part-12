services:\n  nginx:\n    image: nginx:1.21.6\n    volumes:\n      - ./nginx.dev.conf:/etc/nginx/nginx.conf:ro\n    ports:\n      - \"8080:80\"\n    depends_on:\n      - frontend\n  frontend:\n    build:\n      context: ./todo-frontend\n      dockerfile: Dockerfile\n    ports:\n      - \"5173:5173\"\n    volumes:\n      - ./todo-frontend:/usr/src/app\n      - /usr/src/app/node_modules"
